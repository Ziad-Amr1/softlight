/*==================================================
    ROOT
==================================================*/

.root
{
    flex-grow: 1;

    justify-content: center;
    align-items: center;
}

/*==================================================
    BACKGROUND
==================================================*/

.background
{
    position: absolute;

    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    background-image: resource("UI/MainMenuBackground");

    -unity-background-scale-mode: scale-and-crop;
}

/*==================================================
    OVERLAY
==================================================*/

.overlay
{
    position: absolute;

    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    background-color: rgba(0,0,0,0.55);
}

/*==================================================
    CONTENT
==================================================*/

.content
{
    flex-grow: 1;

    justify-content: center;
    align-items: center;

    flex-direction: column;
}

/*==================================================
    LOGO
==================================================*/

.logo-container
{
    align-items: center;

    margin-bottom: 70px;

    opacity: 0;
}

.title
{
    font-size: 72px;

    color: rgb(255,232,70);

    -unity-font-style: bold;

    unity-text-align: middle-center;

    margin-bottom: 10px;
}

.subtitle
{
    font-size: 18px;

    color: rgb(210,210,210);

    unity-text-align: middle-center;

    opacity: 0.85;
}

/*==================================================
    MENU
==================================================*/

.menu-container
{
    width: 320px;

    align-items: center;
}

.menu-button
{
    width: 280px;

    height: 48px;

    margin-top: 8px;
    margin-bottom: 8px;

    background-color: rgba(0,0,0,0);

    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;

    color: rgb(235,235,235);

    font-size: 28px;

    -unity-font-style: bold;

    unity-text-align: middle-center;

    opacity: 0;
}

.menu-button:hover
{
    color: rgb(255,232,70);
}

.menu-button:active
{
    color: rgb(255,190,60);
}

.menu-button.selected
{
    color: rgb(255,232,70);
}

/*==================================================
    FOOTER
==================================================*/

.footer
{
    position: absolute;

    left: 0;
    right: 0;
    bottom: 20px;

    align-items: center;
}

.version
{
    font-size: 14px;

    color: rgba(255,255,255,0.45);

    unity-text-align: middle-center;
}

/*==================================================
                MENU ROW & SELECTOR
==================================================*/

.menu-row
{
    flex-direction: row;       /* السهم والزرار يجوا جنب بعض */
    align-items: center;       /* يتوسطوا أفقياً */
    justify-content: center;   /* يتوسطوا في نص الـ Row */

    width: 280px;              /* عرض ثابت للسطر عشان ميتحركش */
    height: 40px;              /* ارتفاع ثابت */

    margin-top: 2px;           /* القيم اللي انت اختارها */
    margin-bottom: 6px;
}

.selector
{
    width: 24px;               /* مكان محجوز عشان النص ميقفزش */
    margin-right: 8px;         /* مسافة بين السهم والزرار */

    color: rgb(255,232,70);    /* الأصفر */
    font-size: 26px;
    -unity-font-style: bold;

    opacity: 0;                /* مخفي بالـ Default */

    /* تأثير التلاشي لما يظهر ويختفي */
    transition-property: opacity;
    transition-duration: 0.15s;
}

/* لما الماوس يعدى على السطر، ظهر السهم */
.menu-row:hover .selector
{
    opacity: 1;
}

/* نظبط شكل الزرار عشان يشتغل جوه الـ Row */
.menu-button
{
    /* الزرار ياخد الباقي من عرض الـ Row بدل ما نحطلو width ثابت */
    flex-grow: 1; 
    height: 100%;
    
    /* شيلنا الـ width: 280px اللي كان هنا، عشان الـ Row هو اللي بيتحكم دلوقتي */
    
    /* لو عايز النص يتوسط جوه الزرار بعد ما السهم اخد مكانو */
    justify-content: center;
}


